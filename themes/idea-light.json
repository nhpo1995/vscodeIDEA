  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#76818C",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#985124",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#3D6B2E",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#006D73",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#235CA4",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#176F87",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type.class",
        "entity.name.type.record",
        "support.class"
      ],
      "settings": {
        "foreground": "#856018",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#147969",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "constant.other.java"
      ],
      "settings": {
        "foreground": "#303841",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#8A6C1D",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "type": "#176F87",
    "typeParameter": "#176F87",
