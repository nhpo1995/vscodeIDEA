  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7A7E85",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#91B982",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#70C4C4",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#76C7E7",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type.class",
        "entity.name.type.record",
        "support.class"
      ],
      "settings": {
        "foreground": "#E2C077",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#7DCFC1",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "constant.other.java"
      ],
      "settings": {
        "foreground": "#D4D4D4",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#BBB87A",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "type": "#76C7E7",
